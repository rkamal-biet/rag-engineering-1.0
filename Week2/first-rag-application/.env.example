# Copy this file to ".env" and fill in your values. Never commit .env.

# --- Euron EURI (required) ---
EURI_API_KEY="your-euri-api-key-here"
EURI_BASE_URL="https://api.euron.one/api/v1/euri"
EURI_CHAT_MODEL="gpt-4.1-mini"
# Use an embedding model listed in your Euron dashboard
EURI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Vector store: memory (default) | cloud ---
VECTOR_STORE="cloud"
QDRANT_URL="https://xxxx.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-api-key-here"
QDRANT_COLLECTION="novacart_first_rag"

# --- Document registry: sqlite (default) | supabase ---
REGISTRY_BACKEND="supabase"
SQLITE_PATH="rag_registry.db"
# Project URL from Supabase -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
# Use the SECRET key (sb_secret_... or legacy service_role), not the publishable key
SUPABASE_KEY="your-supabase-secret-key-here"

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY="your-langsmith-api-key-here"
LANGSMITH_PROJECT="novacart_first_rag_project"
# EU region only: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- RAG knobs (optional) ---
CHUNK_SIZE=120
CHUNK_OVERLAP=20
TOP_K=5

# --- API (optional) ---
# Index data/ when the server starts (skips unchanged files). Keep true with VECTOR_STORE=memory.
AUTO_INGEST_ON_STARTUP="true"
